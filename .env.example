# ==========================================================
# AI Portfolio Chatbot - Environment Configuration
# ==========================================================

# Port & Server Settings
HOST=0.0.0.0
PORT=8000
API_BASE_URL=http://localhost:8000/api

# Default LLM Provider: "gemini", "openai", "groq", or "offline"
DEFAULT_LLM_PROVIDER=gemini

# Default Embedding Provider: "gemini", "openai", or "local"
DEFAULT_EMBEDDING_PROVIDER=gemini

# API Keys (Optional - the app has a smart offline engine fallback)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# RAG & Chunking Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K_RETRIEVAL=4
